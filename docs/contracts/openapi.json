            "type": "string"
          },
          "arguments": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonObject"
              }
            ]
          },
          "executeLive": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
