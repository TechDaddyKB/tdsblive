{
  "openapi": "3.1.1",
  "info": {
    "title": "ExtensionSuite.Host | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:17474/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/editor": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/provision": {
      "post": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/configuration": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationConfiguration"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationConfiguration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/secrets/{name}": {
      "post": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecretUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CanonicalEvent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/test-event": {
      "post": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/diagnostics": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/diagnostics/logs": {
      "get": {
        "tags": [
          "ExtensionSuite.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminLogin": {
        "required": [
          "credential"
        ],
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ApplicationConfiguration": {
        "type": "object",
        "properties": {
          "server": {
            "$ref": "#/components/schemas/ServerConfiguration"
          },
          "streamerBot": {
            "$ref": "#/components/schemas/IntegrationConfiguration"
          },
          "speakerBot": {
            "$ref": "#/components/schemas/IntegrationConfiguration"
          },
          "rumble": {
            "$ref": "#/components/schemas/RumbleConfiguration"
          },
          "logRetentionDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "minimumLogLevel": {
            "type": "string"
          },
          "retainRawEvents": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CanonicalEvent": {
        "required": [
          "source",
          "platform",
          "type",
          "nativeType",
          "dedupeKey"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "nativeType": {
            "type": "string"
          },
          "nativeId": {
            "type": [
              "null",
              "string"
            ]
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventUser"
              }
            ]
          },
          "message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventMessage"
              }
            ]
          },
          "monetary": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventMoney"
              }
            ]
          },
          "stream": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventStream"
              }
            ]
          },
          "dedupeKey": {
            "type": "string"
          },
          "raw": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonObject"
              }
            ]
          },
          "provenance": {
            "$ref": "#/components/schemas/EventProvenance"
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "bridgePath": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "CsrfResponse": {
        "required": [
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "EventMessage": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "EventMoney": {
        "required": [
          "minorUnits",
          "currency",
          "valuationKind"
        ],
        "type": "object",
        "properties": {
          "minorUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "valuationKind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EventProvenance": {
        "enum": [
          "live",
          "simulation",
          "replay"
        ]
      },
      "EventStream": {
        "required": [
          "id",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "EventUser": {
        "type": "object",
        "properties": {
          "platformUserId": {
            "type": [
              "null",
              "string"
            ]
          },
          "login": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "badges": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "IntegrationConfiguration": {
        "required": [
          "host",
          "port"
        ],
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "IntegrationStates": {
        "required": [
          "streamerBot",
          "speakerBot",
          "rumble"
        ],
        "type": "object",
        "properties": {
          "streamerBot": {
            "type": "string"
          },
          "speakerBot": {
            "type": "string"
          },
          "rumble": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "JsonObject": {
        "type": "object"
      },
      "RumbleConfiguration": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "pollIntervalSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "advancedSlowerPolling": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SecretUpdate": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ServerConfiguration": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "enableLan": {
            "type": "boolean"
          },
          "allowedHosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "StatusResponse": {
        "required": [
          "name",
          "httpSupported",
          "lanEnabled",
          "integrations"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "httpSupported": {
            "type": "boolean"
          },
          "lanEnabled": {
            "type": "boolean"
          },
          "integrations": {
            "$ref": "#/components/schemas/IntegrationStates"
          }
        },
        "additionalProperties": false
      },
      "TestEventRequest": {
        "required": [
          "event"
        ],
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/CanonicalEvent"
          },
          "persist": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "ExtensionSuite.Host"
    }
  ]
}
