              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventStream"
              }
            ]
          },
          "metrics": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventMetrics"
              }
            ]
          },
          "dedupeKey": {
            "type": "string"
          },
          "raw": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonObject"
              }
