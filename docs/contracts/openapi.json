        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "authenticationRequired": {
            "type": "boolean",
            "default": false
          },
          "failureKind": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "BotDiscovery": {
        "required": [
          "events",
          "actions",
          "codeTriggers",
          "eventsSupported",
          "actionsSupported",
          "codeTriggersSupported"
        ],
        "type": "object",
        "properties": {
