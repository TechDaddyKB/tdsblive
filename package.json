{
  "name": "tdsblive",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "frontend/editor",
    "frontend/overlay-runtime"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  },
  "scripts": {
    "lint": "eslint frontend vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4"
  },
  "type": "module"
}
